# Local secrets and configuration
.env
.env.*
!.env.example

# Minecraft runtime data: worlds, logs, generated Forge files, RCON credentials,
# player data, and manually installed mods all stay local by default.
/data/*
!/data/.gitkeep

# Local Forge mod files stay on the host and are copied into the server volume.
/mods/*
!/mods/.gitkeep

# Local server settings exported from the Docker volume.
/server-files/*
!/server-files/.gitkeep

# A local installer/server JAR is not needed by the Docker setup.
/server.jar
