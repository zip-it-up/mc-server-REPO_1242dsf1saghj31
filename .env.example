# Copy this file to .env and paste the agent secret generated by Playit.
# Do not commit the real .env file or share this key.
PLAYIT_SECRET_KEY=

# Optional server settings

# MEMORY=4G | Max RAM usage for your server
# TZ=Your Region/Country
# SERVER_MOTD=My Minecraft server | server description
# ONLINE_MODE=FALSE | for TLauncher or other offline minecraft launchers
# SEED=123456789 | type the seed in quotes if negative, SEED="-123456789"
# GAME_MODE=survival | look the names for each game mode online
# DIFFICULTY=easy | look the names for each diff online
# MAX_PLAYERS=20 | server cap
